# Telegram bot token from @BotFather.
TOKEN=

# DEBUG or PROD.
LOG_LEVEL=DEBUG

# Comma-separated Telegram user IDs allowed to run /status and /broadcast.
ADMIN_IDS=

# Path to the SQLite file. This is the same file the first version of the bot
# wrote, so pointing at an existing naholosy.db keeps everyone's progress.
DB_PATH=naholosy.db
